      "baseMax": 3.0,
      "randomizeBase": false,
      "modulators": []
    },
    "SeedSize": {
      "baseValue": 0.35,
      "baseMin": 0.0,
      "baseMax": 1.0,
      "randomizeBase": false,
      "modulators": []
    },
    "Drift": {
      "baseValue": 0.3,
      "baseMin": 0.0,
      "baseMax": 1.0,
      "randomizeBase": false,
      "modulators": [
        {
          "sourceId": "lfo",
          "operator": "ADD",
          "depth": 0.1,
          "dcOffset": 0.1,
          "waveform": "SINE",
          "genUnit": "BEAT",
          "subdivision": 48.0,
