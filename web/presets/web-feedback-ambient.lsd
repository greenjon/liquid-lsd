        {
          "sourceId": "audio_amp",
          "operator": "ADD",
          "depth": 0.15,
          "dcOffset": 0.0,
          "followerMode": "CUSTOM",
          "attackMs": 200.0,
          "decayMs": 1500.0
        }
      ]
    },
