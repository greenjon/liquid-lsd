{
  "version": 1,
  "name": "web-feedback-ambient",
  "visualSourceType": "video_feedback",
  "parameters": {
    "Zoom": {
      "baseValue": 0.3,
      "baseMin": -1.0,
      "baseMax": 1.0,
      "randomizeBase": false,
      "modulators": []
    },
    "Rotation": {
      "baseValue": 0.2,
      "baseMin": -1.0,
      "baseMax": 1.0,
      "randomizeBase": false,
      "modulators": [
