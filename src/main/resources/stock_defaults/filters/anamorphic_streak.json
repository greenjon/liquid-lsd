{
  "version": 3,
  "metaBindings": [
    {
      "targetParamName": "streakIntensity",
      "minVal": 0.0,
      "maxVal": 1.0
    }
  ],
  "params": {
    "streakIntensity": {
      "note": "Streaks flare on the bass, scaled by the knob.",
      "modulators": [
        {
          "name": "bass flare",
          "sourceId": "audio_bass",
          "operator": "MUL",
          "depth": 0.8,
          "followerMode": "PUNCHY",
          "attackMs": 5,
          "decayMs": 150
        },
        {
          "name": "loudness swell",
          "sourceId": "audio_amp",
          "operator": "MUL",
          "depth": 0.5,
          "followerMode": "SMOOTH",
          "attackMs": 40,
          "decayMs": 400,
          "bypassed": true
        }
      ]
    },
    "streakLength": {
      "note": "Streaks stretch when loud; off by default. Rolls: short glints to full-width streaks.",
      "randomizeBase": true,
      "baseMin": 0.4,
      "baseMax": 1.0,
      "modulators": [
        {
          "name": "loudness swell",
          "sourceId": "audio_amp",
          "operator": "ADD",
          "depth": 0.15,
          "followerMode": "SMOOTH",
          "attackMs": 40,
          "decayMs": 400,
          "bypassed": true
        }
      ]
    },
    "colorMode": {
      "note": "Rolls: every streak colour.",
      "randomizeBase": true,
      "baseMin": 0.0,
      "baseMax": 2.0
    },
    "crossFlare": {
      "note": "Rolls: none to a strong vertical cross. Rolls: none to a strong vertical cross.",
      "randomizeBase": true,
      "baseMin": 0.0,
      "baseMax": 0.9
    },
    "knee": {
      "randomizeBase": true,
      "baseMin": 0.2,
      "baseMax": 0.6
    },
    "threshold": {
      "note": "Rolls: not lower, or the streaks white out the picture. Rolls: not lower, or the streaks white out the picture.",
      "randomizeBase": true,
      "baseMin": 0.35,
      "baseMax": 0.7
    }
  }
}
