{
  "version": 3,
  "metaBindings": [
    {
      "targetParamName": "blurAmount",
      "minVal": 0.0,
      "maxVal": 1.0
    }
  ],
  "params": {
    "blurAmount": {
      "note": "Kick smears the picture, scaled by the knob. Smears hard on the drop; off by default.",
      "modulators": [
        {
          "name": "kick smear",
          "sourceId": "audio_bass",
          "operator": "MUL",
          "depth": 0.8,
          "followerMode": "PUNCHY",
          "attackMs": 5,
          "decayMs": 150
        },
        {
          "name": "drop smear",
          "sourceId": "audio_drop",
          "operator": "MUL",
          "depth": 1.0,
          "bypassed": true
        }
      ]
    },
    "angle": {
      "note": "Slow beat-locked turn of the smear; off by default. Rolls: any direction.",
      "randomizeBase": true,
      "baseMin": -3.14159,
      "baseMax": 3.14159,
      "modulators": [
        {
          "name": "sine 32-beat",
          "sourceId": "lfo",
          "operator": "ADD",
          "waveform": "SINE",
          "genUnit": "BEAT",
          "subdivision": 32,
          "depth": 0.25,
          "bypassed": true
        }
      ]
    },
    "decay": {
      "note": "Rolls: short to long streaks.",
      "randomizeBase": true,
      "baseMin": 0.7,
      "baseMax": 0.97
    },
    "bidirectional": {
      "note": "Rolls: one-sided or both ways.",
      "randomizeBase": true,
      "baseMin": 0.0,
      "baseMax": 1.0
    }
  }
}
