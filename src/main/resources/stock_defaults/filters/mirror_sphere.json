{
  "version": 3,
  "metaBindings": [
    {
      "targetParamName": "sphereRadius",
      "minVal": 0.0,
      "maxVal": 0.8
    }
  ],
  "params": {
    "sphereRadius": {
      "note": "The sphere pumps on the bass, scaled by the knob. The sphere swells on the drop; off by default.",
      "modulators": [
        {
          "name": "bass pulse",
          "sourceId": "audio_bass",
          "operator": "MUL",
          "depth": 0.15,
          "followerMode": "PUNCHY",
          "attackMs": 5,
          "decayMs": 150
        },
        {
          "name": "drop swell",
          "sourceId": "audio_drop",
          "operator": "MUL",
          "depth": 0.4,
          "bypassed": true
        }
      ]
    },
    "fresnelGlow": {
      "note": "Highs light the rim; off by default.",
      "randomizeBase": true,
      "baseMin": 0.2,
      "baseMax": 0.8,
      "modulators": [
        {
          "name": "high shimmer",
          "sourceId": "audio_high",
          "operator": "ADD",
          "depth": 0.3,
          "followerMode": "PUNCHY",
          "attackMs": 5,
          "decayMs": 110,
          "bypassed": true
        }
      ]
    },
    "chromaFringe": {
      "note": "Kick fringe; off by default.",
      "randomizeBase": true,
      "baseMin": 0.0,
      "baseMax": 0.6,
      "modulators": [
        {
          "name": "kick hit",
          "sourceId": "audio_flux_bass",
          "operator": "ADD",
          "depth": 0.25,
          "followerMode": "SNAP",
          "attackMs": 0,
          "decayMs": 35,
          "bypassed": true
        }
      ]
    },
    "centerX": {
      "randomizeBase": true,
      "baseMin": 0.3,
      "baseMax": 0.7
    },
    "centerY": {
      "randomizeBase": true,
      "baseMin": 0.35,
      "baseMax": 0.65
    },
    "backgroundMix": {
      "note": "Rolls: how much of the picture shows around the sphere; never black.",
      "randomizeBase": true,
      "baseMin": 0.1,
      "baseMax": 0.6
    }
  }
}
