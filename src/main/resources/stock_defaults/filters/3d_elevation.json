{
  "version": 3,
  "metaBindings": [
    {
      "targetParamName": "separation",
      "minVal": 0.33333,
      "maxVal": 1.0
    }
  ],
  "params": {
    "separation": {
      "note": "Planes push apart on the bass, scaled by the knob. The planes burst apart on the drop; off by default.",
      "modulators": [
        {
          "name": "bass spread",
          "sourceId": "audio_bass",
          "operator": "MUL",
          "depth": 0.2,
          "followerMode": "PUNCHY",
          "attackMs": 5,
          "decayMs": 150
        },
        {
          "name": "drop burst",
          "sourceId": "audio_drop",
          "operator": "MUL",
          "depth": 0.6,
          "bypassed": true
        }
      ]
    },
    "yaw": {
      "note": "Slow beat-locked sway; off by default.",
      "randomizeBase": true,
      "baseMin": -1.2,
      "baseMax": 1.2,
      "modulators": [
        {
          "name": "sine 32-beat",
          "sourceId": "lfo",
          "operator": "ADD",
          "waveform": "SINE",
          "genUnit": "BEAT",
          "subdivision": 32,
          "depth": 0.1,
          "bypassed": true
        }
      ]
    },
    "zoom": {
      "note": "Kick zoom; off by default. Rolls: not smaller, or the planes shrink to a speck.",
      "randomizeBase": true,
      "baseMin": 0.45,
      "baseMax": 0.75,
      "modulators": [
        {
          "name": "kick zoom",
          "sourceId": "audio_bass",
          "operator": "ADD",
          "depth": 0.05,
          "followerMode": "PUNCHY",
          "attackMs": 5,
          "decayMs": 150,
          "bypassed": true
        }
      ]
    },
    "mode3D": {
      "note": "Rolls: every arrangement of the planes.",
      "randomizeBase": true,
      "baseMin": 0.0,
      "baseMax": 3.0
    },
    "blendMode": {
      "note": "Rolls: alpha-over or additive."
    },
    "pitch": {
      "note": "Rolls: tilt the planes, never edge-on.",
      "randomizeBase": true,
      "baseMin": -1.2,
      "baseMax": 1.2
    },
    "roll": {
      "randomizeBase": true,
      "baseMin": -3.14159,
      "baseMax": 3.14159
    },
    "perspective": {
      "randomizeBase": true,
      "baseMin": 0.25,
      "baseMax": 0.85
    },
    "roundness": {
      "note": "Rolls: square to round planes.",
      "randomizeBase": true,
      "baseMin": 0.0,
      "baseMax": 1.0
    }
  }
}
