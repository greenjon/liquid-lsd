{
  "version": 3,
  "metaBindings": [
    {
      "targetParamName": "trackingJitter",
      "minVal": 0.0,
      "maxVal": 1.0
    }
  ],
  "params": {
    "trackingJitter": {
      "note": "Kick knocks the tracking, scaled by the knob. The tape wrecks on the drop; off by default.",
      "modulators": [
        {
          "name": "kick tracking",
          "sourceId": "audio_flux_bass",
          "operator": "MUL",
          "depth": 1.0,
          "followerMode": "SNAP",
          "attackMs": 0,
          "decayMs": 35
        },
        {
          "name": "drop tape wreck",
          "sourceId": "audio_drop",
          "operator": "MUL",
          "depth": 1.0,
          "bypassed": true
        }
      ]
    },
    "rfDropouts": {
      "note": "Highs add dropouts; off by default.",
      "randomizeBase": true,
      "baseMin": 0.05,
      "baseMax": 0.5,
      "modulators": [
        {
          "name": "high shimmer",
          "sourceId": "audio_high",
          "operator": "ADD",
          "depth": 0.2,
          "followerMode": "PUNCHY",
          "attackMs": 5,
          "decayMs": 110,
          "bypassed": true
        }
      ]
    },
    "ycDelay": {
      "note": "Colour bleed grows when loud; off by default. Rolls: colour bleed.",
      "randomizeBase": true,
      "baseMin": 0.1,
      "baseMax": 0.7,
      "modulators": [
        {
          "name": "loudness swell",
          "sourceId": "audio_amp",
          "operator": "ADD",
          "depth": 0.15,
          "followerMode": "SMOOTH",
          "attackMs": 40,
          "decayMs": 400,
          "bypassed": true
        }
      ]
    },
    "headSwitching": {
      "randomizeBase": true,
      "baseMin": 0.2,
      "baseMax": 0.8
    },
    "tapeNoise": {
      "randomizeBase": true,
      "baseMin": 0.1,
      "baseMax": 0.6
    }
  }
}
