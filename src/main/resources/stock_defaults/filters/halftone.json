{
  "version": 3,
  "metaBindings": [
    {
      "targetParamName": "dotScale",
      "minVal": 0.0,
      "maxVal": 1.0
    }
  ],
  "params": {
    "dotScale": {
      "note": "Dots swell on the bass, scaled by the knob. The dots blow up on the drop; off by default.",
      "modulators": [
        {
          "name": "bass pulse",
          "sourceId": "audio_bass",
          "operator": "MUL",
          "depth": 0.3,
          "followerMode": "PUNCHY",
          "attackMs": 5,
          "decayMs": 150
        },
        {
          "name": "drop blowup",
          "sourceId": "audio_drop",
          "operator": "MUL",
          "depth": 1.0,
          "bypassed": true
        }
      ]
    },
    "screenAngle": {
      "note": "Slow beat-locked screen turn; off by default.",
      "randomizeBase": true,
      "baseMin": -3.14159,
      "baseMax": 3.14159,
      "modulators": [
        {
          "name": "sine 32-beat",
          "sourceId": "lfo",
          "operator": "ADD",
          "waveform": "SINE",
          "genUnit": "BEAT",
          "subdivision": 32,
          "depth": 0.1,
          "bypassed": true
        }
      ]
    },
    "mode": {
      "note": "Rolls: every screen mode.",
      "randomizeBase": true,
      "baseMin": 0.0,
      "baseMax": 2.0
    },
    "smoothness": {
      "randomizeBase": true,
      "baseMin": 0.05,
      "baseMax": 0.4
    },
    "paperTint": {
      "randomizeBase": true,
      "baseMin": 0.0,
      "baseMax": 0.45
    }
  }
}
