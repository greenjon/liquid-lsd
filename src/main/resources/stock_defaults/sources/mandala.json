{
  "version": 1,
  "sourceId": "mandala",
  "parameters": {
    "L1": {
      "note": "Arm 1 jiggles with the amplitude of the music (raw, no smoothing).",
      "modulators": [
        {
          "name": "amplitude jiggle",
          "sourceId": "audio_amp",
          "operator": "ADD",
          "depth": 0.15
        },
        {
          "name": "4-beat sine",
          "sourceId": "lfo",
          "operator": "ADD",
          "bypassed": true,
          "waveform": "SINE",
          "genUnit": "BEAT",
          "subdivision": 4,
          "depth": 0.1,
          "dcOffset": 0.1
        },
        {
          "name": "bass pulse",
          "sourceId": "audio_bass",
          "operator": "ADD",
          "bypassed": true,
          "depth": 0.15,
          "followerMode": "PUNCHY",
          "attackMs": 5,
          "decayMs": 150
        }
      ]
    },
    "L2": {
      "note": "Arm 2 swells and falls on an 8-beat sine.",
      "modulators": [
        {
          "name": "8-beat sine",
          "sourceId": "lfo",
          "operator": "ADD",
          "waveform": "SINE",
          "genUnit": "BEAT",
          "subdivision": 8,
          "depth": 0.175,
          "dcOffset": 0.175
        },
        {
          "name": "mid body",
          "sourceId": "audio_mid",
          "operator": "ADD",
          "bypassed": true,
          "depth": 0.25,
          "followerMode": "SMOOTH",
          "attackMs": 40,
          "decayMs": 400
        }
      ]
    },
    "L3": {
      "note": "Arm 3 jumps to a new length every 16 beats, gliding for the first half of each (50% hold).",
      "modulators": [
        {
          "name": "sample & hold 16-beat",
          "sourceId": "lfo",
          "operator": "ADD",
          "waveform": "RANDOM",
          "genUnit": "BEAT",
          "subdivision": 16,
          "depth": 0.2,
          "hold": 0.5,
          "dcOffset": 0.2
        },
        {
          "name": "16-beat triangle",
          "sourceId": "lfo",
          "operator": "ADD",
          "bypassed": true,
          "waveform": "TRIANGLE",
          "genUnit": "BEAT",
          "subdivision": 16,
          "depth": 0.15,
          "dcOffset": 0.15
        }
      ]
    },
    "L4": {
      "note": "Arm 4 rises on a 6-beat ramp and snaps back, which drifts against the 8 and 16 beat arms.",
      "modulators": [
        {
          "name": "6-beat rising ramp",
          "sourceId": "lfo",
          "operator": "ADD",
          "waveform": "TRIANGLE",
          "genUnit": "BEAT",
          "subdivision": 6,
          "depth": 0.15,
          "slope": 0.85,
          "dcOffset": 0.15
        },
        {
          "name": "bass pulse",
          "sourceId": "audio_bass",
          "operator": "ADD",
          "bypassed": true,
          "depth": 0.25,
          "followerMode": "SMOOTH",
          "attackMs": 40,
          "decayMs": 400
        }
      ]
    },
    "Hue Offset": {
      "note": "Colours cycle once a beat (a sawtooth over the whole hue wheel); a gentle 1-beat sine as the alternative. Not randomized: the LFO already sweeps the whole hue circle from 0.",
      "randomizeBase": false,
      "baseMin": 0,
      "baseMax": 0,
      "modulators": [
        {
          "name": "1-beat hue cycle",
          "sourceId": "lfo",
          "operator": "ADD",
          "waveform": "TRIANGLE",
          "genUnit": "BEAT",
          "subdivision": 1,
          "depth": 0.5,
          "slope": 0.995,
          "dcOffset": 0.5
        },
        {
          "name": "1-beat hue shimmer",
          "sourceId": "lfo",
          "operator": "ADD",
          "bypassed": true,
          "waveform": "SINE",
          "genUnit": "BEAT",
          "subdivision": 1,
          "depth": 0.1,
          "dcOffset": 0.1
        }
      ]
    },
    "Recipe Select": {
      "note": "The die picks the recipe; the sample-and-hold wanders a quarter of the list either side of it every 32 beats.",
      "baseValue": 0.5,
      "randomizeBase": true,
      "baseMin": 0.25,
      "baseMax": 0.75,
      "modulators": [
        {
          "name": "new recipe every 32 beats",
          "sourceId": "lfo",
          "operator": "ADD",
          "waveform": "RANDOM",
          "genUnit": "BEAT",
          "subdivision": 32,
          "depth": 0.25,
          "hold": 1.0,
          "dcOffset": 0
        },
        {
          "name": "new recipe every 64 beats",
          "sourceId": "lfo",
          "operator": "ADD",
          "bypassed": true,
          "waveform": "RANDOM",
          "genUnit": "BEAT",
          "subdivision": 64,
          "depth": 0.25,
          "hold": 1.0,
          "dcOffset": 0
        }
      ]
    },
    "Lobes": {
      "note": "A new lobe count every 256 beats (100% hold), up to about 11 above the base. The die picks the base between 3 and 8, so the drift tops out near 20.",
      "randomizeBase": true,
      "baseMin": 3,
      "baseMax": 8,
      "modulators": [
        {
          "name": "new lobe count every 256 beats",
          "sourceId": "lfo",
          "operator": "ADD",
          "waveform": "RANDOM",
          "genUnit": "BEAT",
          "subdivision": 256,
          "depth": 0.25,
          "hold": 1.0,
          "dcOffset": 0.25
        }
      ]
    },
    "Thickness": {
      "note": "Lines thicken on the bass.",
      "modulators": [
        {
          "name": "bass pulse",
          "sourceId": "audio_bass",
          "operator": "ADD",
          "depth": 0.12,
          "followerMode": "PUNCHY",
          "attackMs": 5,
          "decayMs": 150
        }
      ]
    },
    "Depth": {
      "note": "Loudness deepens the layering; off by default.",
      "modulators": [
        {
          "name": "loudness swell",
          "sourceId": "audio_amp",
          "operator": "ADD",
          "bypassed": true,
          "depth": 0.15,
          "followerMode": "SMOOTH",
          "attackMs": 40,
          "decayMs": 400
        }
      ]
    }
  },
  "macroBank": {
    "knobs": [
      {
        "label": "LOBES",
        "bindings": [
          {
            "parameterId": "Lobes"
          }
        ]
      },
      {
        "label": "THICK",
        "bindings": [
          {
            "parameterId": "Thickness"
          }
        ]
      },
      {
        "label": "DEPTH",
        "bindings": [
          {
            "parameterId": "Depth"
          }
        ]
      },
      {
        "label": "HUE",
        "bindings": [
          {
            "parameterId": "Hue Offset"
          }
        ]
      }
    ]
  }
}
