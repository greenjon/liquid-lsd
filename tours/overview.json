{"dt":3.5,"action":"move","target":"perf_0_r1_c0","durationSec":0.5},
{"dt":0.6,"action":"drag","dy":-110,"durationSec":3.5,"caption":"A slot joins in when the Super Knob passes its current value, so nothing jumps."},
{"dt":6.0,"action":"move","target":"fxlink_deckA_fx_1","durationSec":1.6,"caption":"The link button above a slot adds it to the Super Knob or takes it out. Click to unlink Polar Tunnel."},
{"dt":5.5,"action":"click"},
{"dt":2.5,"action":"move","target":"perf_0_r1_c0","durationSec":1.4,"caption":"Now the Super Knob moves only the linked slots. Polar Tunnel stays put."},
{"dt":2.0,"action":"drag","dy":70,"durationSec":3.0},
{"dt":4.5,"action":"move","target":"fxlink_deckA_fx_1","durationSec":1.4,"caption":"Click again to link it back."},
{"dt":1.8,"action":"click"},
{"dt":2.0,"action":"move","target":"fxchainlink_deckA_fx","durationSec":1.4,"caption":"The link beside the Super Knob links or unlinks all slots at once."},
